---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getAllBerita } from '@/lib/berita';

const latest = (await getAllBerita()).slice(0, 3);
---

<BaseLayout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan atau sudah dipindahkan." noindex canonical={false}>
  <div class="container">
    <header class="page-header not-found">
      <p class="kicker">Error 404</p>
      <h1>Halaman tidak ditemukan</h1>
      <p>Halaman yang Anda cari mungkin sudah dipindahkan atau alamatnya salah ketik.</p>
      <div class="actions">
        <a href="/" class="btn">Kembali ke Beranda</a>
        <a href="/cari/" class="btn btn-ghost">Cari Berita</a>
      </div>
    </header>
    {latest.length > 0 && (
      <section class="section" aria-labelledby="notfound-latest-title">
        <div class="section-head"><h2 id="notfound-latest-title" class="section-title">Berita Terbaru</h2></div>
        <div class="grid grid-3">{latest.map((item) => <ArticleCard item={item} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .not-found { padding-block: 48px 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .btn-ghost { background: transparent; color: var(--color-text); border: 1px solid var(--color-border); }
  .btn-ghost:hover { background: var(--color-surface); color: var(--color-text); }
</style>
