---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { CATEGORIES, SITE } from '@/site.config';
import { beritaUrl, categoryUrl, formatDate, getAllBerita, getCategory } from '@/lib/berita';
import { itemList } from '@/lib/schema';

const all = await getAllBerita();
const headline = all.find((b) => b.data.featured) ?? all[0];
const rest = all.filter((b) => b.id !== headline?.id);
const spotlight = rest.slice(0, 4);
const latest = rest.slice(4, 12);

const categorySections = CATEGORIES.map((c) => {
  const items = all.filter((b) => b.data.category === c.slug);
  return { ...c, count: items.length, items: items.slice(0, 3) };
});
const filledSections = categorySections.filter((c) => c.items.length > 0);

const list = itemList('/', all.slice(0, 10).map((b) => ({ url: beritaUrl(b.id), name: b.data.title })));
---

<BaseLayout title={SITE.name} description={SITE.description} schema={[list]} pageExtra={{ mainEntity: { '@id': list['@id'] } }}>
  <div class="container">
    <h1 class="sr-only">{SITE.name} — {SITE.tagline}</h1>

    {headline && (
      <section id="headline-section" class="headline" aria-label="Berita utama">
        <ArticleCard item={headline} variant="hero" headingLevel="h2" eager />
      </section>
    )}

    {spotlight.length > 0 && (
      <section id="spotlight-section" class="spotlight" aria-labelledby="spotlight-title">
        <h2 id="spotlight-title" class="spotlight-label">Sorotan</h2>
        <ol class="spotlight-list">
          {spotlight.map((item, i) => (
            <li class="spot">
              <span class="spot-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="spot-body">
                <span class="kicker">{getCategory(item.data.category)?.name}</span>
                <h3 class="spot-title"><a href={beritaUrl(item.id)}>{item.data.title}</a></h3>
                <time class="meta" datetime={item.data.pubDate.toISOString()}>{formatDate(item.data.pubDate)}</time>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <div class="main-grid">
      <div class="main-col">
        {latest.length > 0 && (
          <section id="latest-section" class="block" aria-labelledby="latest-title">
            <div class="section-head">
              <h2 id="latest-title" class="section-title">Berita Terbaru</h2>
              <a href="/berita/" class="section-more">Indeks berita →</a>
            </div>
            <div class="feed">
              {latest.map((item) => <ArticleCard item={item} variant="row" />)}
            </div>
          </section>
        )}

        <div class="cat-grid">
          {filledSections.map((c) => (
            <section id={`kategori-${c.slug}-section`} class="block cat-block" aria-labelledby={`kategori-${c.slug}-title`}>
              <div class="section-head">
                <h2 id={`kategori-${c.slug}-title`} class="section-title"><a href={categoryUrl(c.slug)}>{c.name}</a></h2>
                <a href={categoryUrl(c.slug)} class="section-more" aria-label={`Lihat semua berita ${c.name}`}>Semua →</a>
              </div>
              <ArticleCard item={c.items[0]} />
              {c.items.length > 1 && (
                <ul class="cat-more">
                  {c.items.slice(1).map((item) => <li><ArticleCard item={item} variant="compact" /></li>)}
                </ul>
              )}
            </section>
          ))}
        </div>
      </div>

      <aside class="rail" aria-label="Rubrik dan tentang">
        <section class="rail-box" aria-labelledby="rail-rubrik-title">
          <h2 id="rail-rubrik-title" class="rail-title">Rubrik</h2>
          <ul class="rubrik">
            {categorySections.map((c) => (
              <li>
                <a href={categoryUrl(c.slug)}><span>{c.name}</span><span class="rubrik-count">{c.count}</span></a>
              </li>
            ))}
          </ul>
        </section>
        <section class="rail-box rail-about" aria-labelledby="rail-about-title">
          <h2 id="rail-about-title" class="rail-title">Tentang</h2>
          <p>{SITE.description}</p>
          <a href="/tentang/" class="section-more">Selengkapnya →</a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .headline { padding-top: 32px; }

  /* Sorotan: deretan bernomor tanpa gambar */
  .spotlight { display: grid; gap: 0; margin-top: 32px; border-block: 1px solid var(--color-border); }
  @media (min-width: 900px) { .spotlight { grid-template-columns: 110px 1fr; align-items: stretch; } }
  .spotlight-label {
    font: 700 0.6875rem/1 var(--font-sans); letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-gold-ink); padding-block: 18px 0;
  }
  @media (min-width: 900px) { .spotlight-label { padding-block: 24px; } }
  .spotlight-list { list-style: none; display: grid; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .spotlight-list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .spotlight-list { grid-template-columns: repeat(4, 1fr); } }
  .spot { display: flex; gap: 14px; padding: 20px 0; border-top: 1px solid var(--color-border); }
  .spot:first-child { border-top: 0; }
  @media (min-width: 640px) {
    .spot { padding: 24px 20px; border-top: 0; border-left: 1px solid var(--color-border); }
  }
  @media (min-width: 900px) { .spot:first-child { border-left: 0; } }
  @media (min-width: 640px) and (max-width: 1099px) { .spot:nth-child(n+3) { border-top: 1px solid var(--color-border); } .spot:nth-child(odd) { border-left: 0; padding-left: 0; } }
  .spot-num { font: 500 2rem/1 var(--font-serif); color: var(--color-gold); min-width: 2.2ch; }
  .spot-body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .spot-title { font-size: 1rem; line-height: 1.35; }
  .spot-title a:hover { color: var(--color-accent); }

  /* Konten utama + rail */
  .main-grid { display: grid; gap: 48px; grid-template-columns: 1fr; margin-top: 8px; }
  @media (min-width: 1024px) { .main-grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; } }
  .main-col { min-width: 0; }
  .block { margin-top: 48px; }
  .feed { display: grid; gap: 32px; }
  .feed > :global(.card) { padding-bottom: 32px; border-bottom: 1px solid var(--color-border); }
  .feed > :global(.card:last-child) { padding-bottom: 0; border-bottom: 0; }

  .cat-grid { display: grid; gap: 0 40px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cat-block { display: flex; flex-direction: column; gap: 0; }
  .cat-block .section-head { margin-bottom: 20px; }
  .cat-more { list-style: none; display: grid; gap: 16px; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--color-border); }

  .rail { display: grid; gap: 40px; align-content: start; margin-top: 48px; }
  @media (min-width: 1024px) { .rail { position: sticky; top: 24px; align-self: start; } }
  .rail-title {
    font: 700 0.6875rem/1 var(--font-sans); letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-gold-ink); padding-bottom: 14px; margin-bottom: 4px; border-bottom: 1px solid var(--color-border);
  }
  .rubrik { list-style: none; }
  .rubrik a {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 12px 0; border-bottom: 1px solid var(--color-border);
    font: 500 1.0625rem/1.3 var(--font-serif);
  }
  .rubrik a:hover { color: var(--color-accent); padding-left: 4px; }
  .rubrik a { transition: padding 0.2s ease; }
  .rubrik-count { font: 600 0.75rem/1 var(--font-sans); color: var(--color-muted); }
  .rail-about { background: var(--color-surface); padding: 24px; border-radius: var(--radius); border-top: 2px solid var(--color-gold); }
  .rail-about .rail-title { border-bottom: 0; padding-bottom: 0; margin-bottom: 12px; }
  .rail-about p { color: var(--color-muted); font-size: 0.9375rem; margin-bottom: 14px; }
  @media (prefers-reduced-motion: reduce) { .rubrik a { transition: none; } }
</style>
