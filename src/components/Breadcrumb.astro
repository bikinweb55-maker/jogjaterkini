---
export interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href && i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb { font-size: 0.8125rem; color: var(--color-muted); padding-block: 16px 0; }
  ol { display: flex; flex-wrap: wrap; list-style: none; gap: 6px; }
  li { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
  li + li::before { content: '›'; opacity: 0.6; }
  li:last-child span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 60vw; display: inline-block; }
</style>
