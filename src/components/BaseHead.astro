---
import '@/styles/global.css';
import { SITE } from '@/site.config';

export interface ArticleMeta {
  publishedTime: Date;
  modifiedTime?: Date;
  section: string;
  tags: string[];
  authorUrl: string;
}

export interface Props {
  title: string;
  description: string;
  /** Path canonical; `false` = tanpa canonical (mis. halaman 404). */
  canonical?: string | false;
  /** Path atau URL absolut gambar OG (idealnya 1200×630 / 1200×675). */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  article?: ArticleMeta;
  noindex?: boolean;
  /** Dokumen JSON-LD yang sudah diserialisasi. */
  jsonLd?: string;
}

const {
  title, description, canonical, image, imageAlt, imageWidth = 1200, imageHeight = 630,
  type = 'website', article, noindex = false, jsonLd,
} = Astro.props;
const canonicalURL = canonical === false ? undefined : new URL(canonical ?? Astro.url.pathname, SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
const imageURL = new URL(image ?? SITE.defaultOgImage, SITE.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonicalURL && <link rel="canonical" href={canonicalURL} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#9b2c1c" />
<meta name="generator" content={Astro.generator} />

<link rel="alternate" type="application/rss+xml" title={`RSS ${SITE.name}`} href="/rss.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:title" content={title === SITE.name ? fullTitle : title} />
<meta property="og:description" content={description} />
{canonicalURL && <meta property="og:url" content={canonicalURL} />}
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt ?? title} />
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    <meta property="article:modified_time" content={(article.modifiedTime ?? article.publishedTime).toISOString()} />
    <meta property="article:section" content={article.section} />
    <meta property="article:author" content={article.authorUrl} />
    {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title === SITE.name ? fullTitle : title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

<slot />
