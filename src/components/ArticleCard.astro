---
import { Image } from 'astro:assets';
import { beritaUrl, formatDate, getCategory, type Berita } from '@/lib/berita';
import { getCover } from '@/lib/cover';

export interface Props {
  item: Berita;
  variant?: 'hero' | 'default' | 'row' | 'compact';
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { item, variant = 'default', headingLevel = 'h3', eager = false } = Astro.props;
const { title, description, pubDate, category } = item.data;
const cover = getCover(item);
const url = beritaUrl(item.id);
const cat = getCategory(category);
const Heading = headingLevel;

const imageProps = {
  hero: { widths: [640, 1000, 1400, 1800], sizes: '(min-width: 1240px) 1184px, 100vw' },
  default: { widths: [400, 640, 800], sizes: '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw' },
  row: { widths: [320, 480, 640], sizes: '(min-width: 640px) 280px, 100vw' },
  compact: { widths: [120, 240], sizes: '112px' },
}[variant];
---

<article class={`card card--${variant}`}>
  <a href={url} class="card-media" tabindex="-1" aria-hidden="true">
    <Image
      src={cover.src}
      alt={cover.alt}
      {...imageProps}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </a>
  <div class="card-body">
    {variant !== 'compact' && cat && <span class="kicker">{cat.name}</span>}
    <Heading class="card-title"><a href={url}>{title}</a></Heading>
    {variant !== 'compact' && <p class="card-excerpt">{description}</p>}
    <time class="meta" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .card-media { display: block; overflow: hidden; border-radius: var(--radius); background: var(--color-surface); }
  .card-media img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 0.5s ease; }
  .card:hover .card-media img { transform: scale(1.035); }
  .card-body { display: flex; flex-direction: column; gap: 8px; }
  .card-title { font-size: 1.1875rem; }
  .card-title a:hover { color: var(--color-accent); }
  .card-excerpt {
    color: var(--color-muted); font-size: 0.9375rem;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Hero: gambar penuh dengan teks di atas gradasi gelap */
  .card--hero { position: relative; display: block; border-radius: var(--radius); overflow: hidden; background: var(--color-ink); }
  .card--hero .card-media { border-radius: 0; }
  .card--hero .card-media img { aspect-ratio: 4 / 5; }
  @media (min-width: 640px) { .card--hero .card-media img { aspect-ratio: 16 / 9; } }
  @media (min-width: 1024px) { .card--hero .card-media img { aspect-ratio: 21 / 9; } }
  .card--hero .card-body {
    position: absolute; inset: auto 0 0 0; gap: 12px;
    padding: 80px clamp(20px, 4vw, 56px) clamp(20px, 3.5vw, 44px);
    background: linear-gradient(to top, rgb(10 16 13 / 0.92) 0%, rgb(10 16 13 / 0.55) 55%, transparent 100%);
    color: #f6f1e4;
  }
  .card--hero .kicker { color: #e3c474; }
  .card--hero .card-title { font-size: clamp(1.625rem, 3.6vw, 2.875rem); max-width: 26ch; letter-spacing: -0.01em; }
  .card--hero .card-title a { color: inherit; }
  .card--hero .card-title a::after { content: ''; position: absolute; inset: 0; }
  .card--hero .card-excerpt { color: rgb(246 241 228 / 0.82); font-size: 1.0625rem; max-width: 62ch; -webkit-line-clamp: 2; }
  .card--hero .meta { color: rgb(246 241 228 / 0.7); }
  @media (max-width: 639px) { .card--hero .card-excerpt { display: none; } }

  /* Row: gambar kiri, teks kanan */
  @media (min-width: 640px) {
    .card--row { flex-direction: row; gap: 24px; align-items: flex-start; }
    .card--row .card-media { flex: 0 0 280px; }
    .card--row .card-media img { aspect-ratio: 4 / 3; }
  }
  .card--row .card-title { font-size: 1.375rem; }

  .card--compact { flex-direction: row; align-items: flex-start; gap: 14px; }
  .card--compact .card-media { flex: 0 0 96px; }
  .card--compact .card-media img { aspect-ratio: 1 / 1; }
  .card--compact .card-title { font-size: 1rem; }
  @media (prefers-reduced-motion: reduce) { .card-media img { transition: none; } }
</style>
