---
import { CATEGORIES, CREDIT, FOOTER_LINKS, SITE } from '@/site.config';
import { categoryUrl } from '@/lib/berita';
const year = new Date().getFullYear();
---

<footer id="site-footer" class="site-footer">
  <div class="container footer-grid">
    <section class="footer-about" aria-labelledby="footer-about-title">
      <h2 id="footer-about-title" class="footer-brand">Jogja<em>Terkini</em></h2>
      <p>{SITE.description}</p>
      <p class="mail">Redaksi · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </section>
    <nav aria-labelledby="footer-kategori-title">
      <h2 id="footer-kategori-title" class="footer-title">Rubrik</h2>
      <ul>
        {CATEGORIES.map((c) => <li><a href={categoryUrl(c.slug)}>{c.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-labelledby="footer-info-title">
      <h2 id="footer-info-title" class="footer-title">Informasi</h2>
      <ul>
        {FOOTER_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} {SITE.name}. Hak cipta dilindungi undang-undang.</p>
    <p class="credit"><a href={CREDIT.path}>Credit</a></p>
    {SITE.social.length > 0 && (
      <ul class="social">
        {SITE.social.map((s) => <li><a href={s.url} rel="me noopener" target="_blank">{s.name}</a></li>)}
      </ul>
    )}
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px; background: var(--color-ink); color: var(--color-on-ink);
    border-top: 3px solid var(--color-gold); font-size: 0.9375rem;
  }
  .site-footer a:hover { color: var(--color-gold); }
  .footer-grid { display: grid; gap: 40px; padding-block: 56px 44px; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr; gap: 64px; } }
  .footer-brand { font: 500 2rem/1 var(--font-serif); letter-spacing: -0.02em; margin-bottom: 16px; }
  .footer-brand em { font-style: italic; font-weight: 600; color: var(--color-gold); margin-left: 0.08em; }
  .footer-about p:first-of-type { opacity: 0.72; max-width: 50ch; }
  .mail { margin-top: 16px; font-size: 0.875rem; }
  .mail a { text-decoration: underline; text-decoration-color: var(--color-gold); text-underline-offset: 3px; }
  .footer-title {
    font: 700 0.6875rem/1 var(--font-sans); text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-gold); margin-bottom: 18px;
  }
  ul { list-style: none; }
  li + li { margin-top: 10px; }
  .footer-bottom {
    display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between;
    padding-block: 22px; border-top: 1px solid rgb(255 255 255 / 0.12); font-size: 0.8125rem; opacity: 0.7;
  }
  .site-footer .credit a, .site-footer .credit a:hover { color: inherit; text-decoration: none; }
  .social { display: flex; gap: 16px; }
  .social li + li { margin-top: 0; }
</style>
